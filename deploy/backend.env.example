# Backend runtime secrets. Copy to backend.env, keep it outside Git and images.
DATABASE_URL=
RIYA_DATABASE_SCHEMA=trip_planner_dev
RIYA_AUTO_MIGRATE=false

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
PLANNING_ENABLED=true
PLANNER_MODEL_REQUEST_LIMIT=16
PLANNER_RESPONSE_TOKEN_LIMIT=4096
GOOGLE_MAPS_API_KEY=
ORS_API_KEY=
TAVILY_API_KEY=
# Add booking-provider variables only if that integration is needed.

RATE_LIMIT_TRIPS_PER_MONTH=3
RATE_LIMIT_MESSAGES_PER_DAY=30
RATE_LIMIT_MESSAGES_PER_MINUTE=5
RIYA_MAX_REQUEST_BYTES=32000
RIYA_REQUESTS_PER_MINUTE=60

TRIPAI_TRACING_ENABLED=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TripAi
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
